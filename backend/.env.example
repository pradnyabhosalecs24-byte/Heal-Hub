# Copy to .env for local development. On Render, set these in the dashboard (Environment tab).
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed web origins (Vercel site / admin portal). Mobile apps don't need CORS.
CORS_ORIGINS=http://localhost:3000,https://healhub.vercel.app
# Firebase service account JSON, base64-encoded on ONE line (see docs/SETUP.md, step 5).
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
